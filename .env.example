# Copy this file to .env and fill it in.

# Dashboard password used on the FIRST start (change it later in Settings → Security).
DASHBOARD_PASSWORD=change-me-please

# Port the dashboard listens on.
PORT=3000

# Set to 1 if the app runs behind Nginx/Caddy/Cloudflare with HTTPS (for secure cookies).
TRUST_PROXY=0

# How long a login lasts, in hours.
SESSION_HOURS=72

# Where the database and WhatsApp session are stored.
DATA_DIR=./data

# Optional: AI fallback for chemicals the rules can't recognise (switch on in Settings).
ANTHROPIC_API_KEY=

# Set to 1 to run the dashboard without connecting to WhatsApp (for testing).
WA_DISABLED=0
