# Copy this file to .env and fill it in.

# Dashboard password used on the FIRST start (min 8 characters; change it later in Settings → Security).
DASHBOARD_PASSWORD=change-me-please

# Your business contact number, shown as {contact_phone} in quotations.
CONTACT_PHONE=+91 90000 00000

# Only for running on a web server with docker-compose: the web address of your dashboard.
# Point this domain's DNS (A record) at your server's IP first. Caddy then sets up HTTPS automatically.
DOMAIN=quotes.yourcompany.in

# Port the dashboard listens on.
PORT=3000

# Who can open the dashboard. 127.0.0.1 = only this computer (safest).
# Use 0.0.0.0 to allow other devices on your network — only behind HTTPS if it's reachable from the internet.
HOST=127.0.0.1

# Set to 1 if the app runs behind Nginx/Caddy/Cloudflare with HTTPS (for secure cookies).
TRUST_PROXY=0

# How long a login lasts, in hours.
SESSION_HOURS=72

# Where the database and WhatsApp session are stored.
DATA_DIR=./data

# Optional: AI fallback for chemicals the rules can't recognise (switch on in Settings).
ANTHROPIC_API_KEY=

# ---- Off-site encrypted backups (strongly recommended on a server) — see DEPLOY.md → Off-site backups ----
# Any S3-compatible storage. AWS S3 Mumbai example:
#   BACKUP_S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com   BACKUP_S3_REGION=ap-south-1
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=quotebot/
# Backups are encrypted with this before upload. At least 16 characters; make one with:  openssl rand -base64 32
# KEEP A COPY SOMEWHERE SAFE (password manager + paper). Without it, the off-site backups cannot be opened.
BACKUP_ENCRYPTION_PASSPHRASE=

# Name shown on the bot's phone under WhatsApp → Settings → Linked devices (applies when you next link).
WA_DEVICE_NAME=Quote Bot

# Set to 1 to run the dashboard without connecting to WhatsApp (for testing).
WA_DISABLED=0
